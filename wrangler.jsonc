{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandrewang",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    // O Worker roda antes dos arquivos só onde precisa: API e redirecionamento por país.
    "run_worker_first": ["/api/*", "/", "/index.html", "/projetos/*", "/publicacoes/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alexandrewang",
      "database_id": "47b5fc03-156d-4d72-b0c3-676ffba54b57",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Preencha depois de criar o aplicativo no Cloudflare Access (veja docs/CLOUDFLARE.md).
    // Enquanto estiverem vazios, as rotas /api/admin/* respondem 503: o painel fica fechado.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
